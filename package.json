{
  "name": "luna-ai",
  "version": "0.4.0",
  "description": "LUNA - Advanced Windows AI Companion (2D animated characters, offline-first)",
  "main": "out/main/index.js",
  "private": true,
  "author": {
    "name": "Tauseef666-ctrl"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "design": "vite -c vite.design.config.ts",
    "design:build": "vite build -c vite.design.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html,css}\"",
    "package": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
